# Trade Intelligence AI — Environment Configuration Example
# Copy this file to .env and configure your preferences.
# NEVER commit your actual .env file with real credentials to source control.

APP_NAME="Trade Intelligence AI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Host & Ports
HOST="127.0.0.1"
PORT=8000

# Database
DATABASE_URL="sqlite:///./trade_intelligence.db"

# Data Provider ("demo" for synthetic simulation, "angel_one" for live broker feeds)
DATA_PROVIDER="demo"
DEMO_MODE=true

# Angel One SmartAPI Credentials (Optional - for live market data streaming)
ANGEL_API_KEY=""
ANGEL_CLIENT_CODE=""
ANGEL_PIN=""
ANGEL_TOTP_SECRET=""
ANGEL_FEED_TOKEN=""
ANGEL_AUTH_TOKEN=""

# Intraday Risk Management Defaults (NSE Equity)
DEFAULT_CAPITAL=100000.0
DEFAULT_MAX_RISK_PER_TRADE_PCT=1.0
DEFAULT_MAX_PORTFOLIO_EXPOSURE_PCT=50.0
DEFAULT_BROKERAGE_PER_ORDER=20.0
DEFAULT_SLIPPAGE_BPS=5.0
